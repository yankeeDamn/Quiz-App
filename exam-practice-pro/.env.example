# ExamPro Next.js frontend on Vercel. Copy to .env.local for Windows development.
# Never expose secrets as NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:3001
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Configure either or both providers; unconfigured buttons are hidden.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional (numeric country code and number)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Show the Cashfree sandbox test checkout on /pricing. Set to true ONLY on the
# isolated staging Vercel project; production pricing stays on WhatsApp/manual.
NEXT_PUBLIC_CASHFREE_SANDBOX_CHECKOUT=false
