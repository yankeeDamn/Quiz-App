# ──────────────────────────────────────────────────────────
# Exam Practice Pro — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to source control.
# ──────────────────────────────────────────────────────────

# ─── Server ────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL) ─────────────────────────────
# Required for persistent data (quiz attempts, bookmarks, notes, payments).
# Local development: use docker-compose to start a PostgreSQL container.
DATABASE_URL=postgresql://exam_user:exam_password@localhost:5432/exam_practice_pro

# ─── Stripe ────────────────────────────────────────────
# Get your keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... and pk_test_... keys for development
# Use sk_live_... and pk_live_... keys for production
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ─── Authentication ───────────────────────────────────
# JWT_SECRET is used for the backend custom JWT signing.
# AUTH_SECRET must match the same value used in exam-practice-pro/.env.local
# so the backend can verify tokens minted by the Next.js frontend.
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ─── Firebase ─────────────────────────────────────────
# Firebase project ID for verifying Firebase ID tokens.
# Get this from the Firebase Console → Project Settings.
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# ─── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Must include the Next.js frontend URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=info
