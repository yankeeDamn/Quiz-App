# ExamPro Express API (.env) — never commit real values
NODE_ENV=development
PORT=3001
# Set a local PostgreSQL or Neon PostgreSQL URL only on your machine / Render.
DATABASE_URL=
# Use the exact same AUTH_SECRET value in Vercel and Render.
AUTH_SECRET=
JWT_SECRET=
ADMIN_EMAILS=
# Optional CLI-only key, minimum 24 characters (leave blank to disable)
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,https://quiz-app-virid-zeta-41.vercel.app
LOG_LEVEL=info

# Optional Microsoft Azure AI Translator (Render backend only).
# Azure Portal → Translator → Keys and Endpoint. Never add these to NEXT_PUBLIC_*.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Optional. Default global text translation API. Must be an approved Azure HTTPS host.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Best-effort, per-Render-instance daily character budget (not an Azure billing cap).
AZURE_TRANSLATOR_DAILY_CHARS=60000

# ── Isolated staging only (never set these enabled values on production) ──
# Enables admin draft-exam routes, beta invitations/feedback and the Cashfree
# sandbox checkout. Requires EXAMPRO_ENV=staging plus the draft gate.
EXAMPRO_ENV=
ENABLE_ADMIN_DRAFT_TESTS=false

# Cashfree Payments — SANDBOX ONLY (see docs/PR64_CASHFREE_SANDBOX.md).
# Disabled by default; every variable below must be set exactly as documented
# or the feature refuses to run. The backend hardcodes
# https://sandbox.cashfree.com/pg; no production/live payment mode exists until
# merchant onboarding is approved (issue #39). Credentials are server-only,
# never NEXT_PUBLIC_*.
CASHFREE_SANDBOX_ENABLED=false
CASHFREE_ENV=sandbox
# Test credentials from the Cashfree sandbox merchant dashboard.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Cashfree PG REST API version header (x-api-version) is pinned in code (2025-01-01).
# HTTPS origin of the staging Render API that receives Cashfree webhooks (must not be the production API).
CASHFREE_SANDBOX_API_ORIGIN=
# Exact staging frontend origin for the Cashfree return URL; must equal https://exampro-staging-ui.vercel.app.
CASHFREE_SANDBOX_FRONTEND_ORIGIN=

# Government Jobs personal application tracker (server-side ONLY).
# Optional, disabled/fails closed until its manually reviewed table exists.
# Generate a UNIQUE 32-byte Base64 secret PER environment, e.g. locally with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Do not commit an actual key, use NEXT_PUBLIC_*, or share across staging/production.
# Back up and manage this secret securely; losing it makes saved references unreadable.
GOVT_APPLICATION_ENCRYPTION_KEY=
