# ExamPro Express API (.env) — never commit real values
NODE_ENV=development
PORT=3001
# Set a local PostgreSQL or Neon PostgreSQL URL only on your machine / Render.
DATABASE_URL=
# Use the exact same AUTH_SECRET value in Vercel and Render.
AUTH_SECRET=
JWT_SECRET=
ADMIN_EMAILS=
# Optional CLI-only key, minimum 24 characters (leave blank to disable)
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,https://quiz-app-virid-zeta-41.vercel.app
LOG_LEVEL=info

# Optional Microsoft Azure AI Translator (Render backend only).
# Azure Portal → Translator → Keys and Endpoint. Never add these to NEXT_PUBLIC_*.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Optional. Default global text translation API. Must be an approved Azure HTTPS host.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Best-effort, per-Render-instance daily character budget (not an Azure billing cap).
AZURE_TRANSLATOR_DAILY_CHARS=60000

# Optional Cashfree Payments sandbox checkout (isolated STAGING only, never production).
# Disabled by default. Every variable below must be set exactly as documented in
# docs/PR64_CASHFREE_SANDBOX.md or the feature refuses to run. No production/live
# payment mode exists until merchant onboarding is approved (issue #39).
CASHFREE_SANDBOX_ENABLED=false
CASHFREE_ENV=sandbox
# Test credentials from the Cashfree sandbox merchant dashboard. Server-only, never NEXT_PUBLIC_*.
CASHFREE_APP_ID=TEST...
CASHFREE_SECRET_KEY=TEST_...
# Cashfree PG REST API version header (x-api-version) is pinned in code (2025-01-01).
# HTTPS staging Render origin that receives Cashfree webhooks (must not be the production API).
CASHFREE_SANDBOX_API_ORIGIN=
# Exact staging frontend origin for the Cashfree return URL.
CASHFREE_SANDBOX_FRONTEND_ORIGIN=
