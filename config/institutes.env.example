# API: leave false until a separately approved migration and staging acceptance.
INSTITUTES_ENABLED=false
INSTITUTE_DELIVERY_ENABLED=false
NEXT_PUBLIC_INSTITUTES_ENABLED=false
# Generate independently per environment; server-only, minimum 32 characters.
INSTITUTE_INVITATION_SECRET=
# Staging frontend (build-time values):
NEXT_PUBLIC_API_URL=https://exampro-staging-api.onrender.com
NEXT_PUBLIC_APP_ENV=staging
# Synthetic local production-build QA only:
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_APP_ENV=local
# No live Cashfree credentials or entitlement grants are included.

# Optional unattended deadline grading; enable only after reporting migration review.
INSTITUTE_EXPIRY_WORKER_ENABLED=false

# Sandbox-only B2B implementation. These do not enable live charging.
INSTITUTE_BILLING_ENABLED=false
INSTITUTE_QUOTAS_ENABLED=false
# Server-side environment; production is explicitly rejected by institute billing.
# APP_ENV=staging
# Reuse separately configured Cashfree sandbox variables documented in .env.example.
